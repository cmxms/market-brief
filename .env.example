# market-brief credentials.
#
# Copy this file to <runtime>/config/.env and fill in real values.
#
# <runtime> is $MARKET_BRIEF_RUNTIME if you set it, otherwise a `runtime/` folder
# inside the repository. Run `python -c "import config; print(config.RUNTIME)"`
# from the repository to see which one this checkout uses.
#
# The file is never committed, and every key declared here is stripped from the
# compose step's environment before the writer model starts.

# Tradier — live options chain for dealer-gamma (GEX). REQUIRED: without it the
# gamma section is unavailable. A brokerage or a free developer account works.
# https://developer.tradier.com/
TRADIER_API_KEY=your_tradier_token_here

# Finnhub — overnight headlines (free tier is fine). REQUIRED for the news
# section. https://finnhub.io/
FINNHUB_API_KEY=your_finnhub_key_here

# FRED — OPTIONAL. Treasury-yield fallback only; the brief works without it
# (US Treasury par-curve + CNBC/Yahoo cover yields). It is also how the event
# calendar reads BLS dates, since bls.gov blocks automated fetches.
# https://fred.stlouisfed.org/docs/api/
FRED_API_KEY=

# Discord — where the finished brief is posted. One or more incoming-webhook
# URLs, comma- or whitespace-separated (fan-out to multiple servers). Optional
# second var DISCORD_WEBHOOK_URLS is also read and merged.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy,https://discord.com/api/webhooks/aaa/bbb
