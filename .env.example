# market-brief credentials. Copy this file to `.env` and fill in real values.
# Real environment variables (e.g. CI secrets) override anything set here.

# Tradier — live options chain for dealer-gamma (GEX). A brokerage or a free
# developer account works. https://developer.tradier.com/
TRADIER_API_KEY=your_tradier_token_here

# Finnhub — overnight headlines (free tier is fine). https://finnhub.io/
FINNHUB_API_KEY=your_finnhub_key_here

# FRED — OPTIONAL. Treasury-yield fallback only; the brief works without it
# (US Treasury par-curve + CNBC/Yahoo cover yields). https://fred.stlouisfed.org/docs/api/
FRED_API_KEY=

# Discord — where the finished brief is posted. One or more incoming-webhook URLs,
# comma- or whitespace-separated (fan-out to multiple servers). Optional second var
# DISCORD_WEBHOOK_URLS is also read and merged.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy,https://discord.com/api/webhooks/aaa/bbb
